{
    "name": "Unshopify",
    "description": "Help preserve Canadian sovereignty by avoiding traitors and oligarchs.",
    "version": "1.0",
    "manifest_version": 3,
    "permissions": [
        "activeTab",
        "scripting",
        "notifications"
    ],
    
    "action": {
        "default_title": "UnShopify"
    },

    "icons": {
        "16" : "images/icon-16.png", 
        "32" : "images/icon-32.png", 
        "48" : "images/icon-48.png", 
        "128": "images/icon-128.png" 
    },

    "content_scripts": [
        {
            "js": ["scripts/detect_shopify.js"],
            "matches": [
                "http://*/",
                "http://*/*",
                "https://*/",
                "https://*/*"
            ]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": ["images/*.png"],
            "matches": ["*://*/*"]
        }
    ]
}